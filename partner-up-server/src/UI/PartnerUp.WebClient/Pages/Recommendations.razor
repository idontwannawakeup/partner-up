@page "/recommendations/{TeamId:guid}"
@inject IStringLocalizer<SharedLocalization> SharedLocalizer
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IFriendsService FriendsService
@inject IUsersService UsersService
@inject RequestErrorsHandler RequestErrorsHandler

<MudTable Class="mt-md-12 mb-12"
          T="@UserViewModel"
          ServerData="@InitializeRecommendedTeammatesAsync"
          @ref="@_table"
          Hover="@true"
          Breakpoint="@Breakpoint.Sm"
          Elevation="0"
          Dense="@true"
          OnRowClick="@(SelectRecommendedUser)"
          RowClass="cursor-pointer">
    <ToolBarContent>
        <MudText Typo="@Typo.h3">
            Recommended teammates
        </MudText>
        <MudSpacer />
    </ToolBarContent>
    <HeaderContent>
        <MudTh>@SharedLocalizer["Name"]</MudTh>
        <MudTh>@SharedLocalizer["Profession"]</MudTh>
        <MudTh>@SharedLocalizer["Specialization"]</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@SharedLocalizer["Name"]">
            <MudElement HtmlTag="div" Class="d-flex align-center">
                <MudAvatar Image="@(context.Avatar is not null ? $"{Configuration["ApiUrl"]}/{context.Avatar}" : null)"
                           Color="@Color.Info">
                    A
                </MudAvatar>
                <MudText Typo="@Typo.subtitle1" Class="ml-4">@context.FullName</MudText>
            </MudElement>
        </MudTd>
        <MudTd DataLabel="@SharedLocalizer["Profession"]">
            @if (!string.IsNullOrWhiteSpace(context.Profession))
            {
                @context.Profession
            }
            else
            {
                <NoneChip />
            }
        </MudTd>
        <MudTd DataLabel="@SharedLocalizer["Specialization"]">
            @if (!string.IsNullOrWhiteSpace(context.Specialization))
            {
                @context.Specialization
            }
            else
            {
                <NoneChip />
            }
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@if (_user is not null)
{
    <MudPaper Elevation="@Elevation" Class="mt-10">
        <MudGrid>
            @if (!string.IsNullOrWhiteSpace(_user.Avatar))
            {
                <MudItem xs="6" md="4" Class="mx-auto mx-md-0 pa-6">
                    <MudElement HtmlTag="div"
                                Style="@($"background: url({Configuration["ApiUrl"]}/{_user.Avatar}) no-repeat center; background-size: cover; width: 350px; height: 250px;")"/>
                </MudItem>
            }
            <MudItem xs="12" md="8">
                <MudElement HtmlTag="div" Class="user-profile__main-information pa-6">
                    <MudElement HtmlTag="div" Class="user-profile__title">
                        <MudText Typo="@Typo.h5" Color="@Color.Dark">@_user.FullName</MudText>
                        <MudText Typo="@Typo.subtitle1" Color="@Color.Surface">@_user.UserName</MudText>
                        @if (!string.IsNullOrWhiteSpace(_user.Profession))
                        {
                            <MudText Typo="@Typo.subtitle1" Color="@Color.Secondary">@_user.Profession</MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(_user.Specialization))
                        {
                            <MudText Typo="@Typo.subtitle1" Color="@Color.Primary">@_user.Specialization</MudText>
                        }
                        <MudElement HtmlTag="div" Class="user-profile__rating mt-4">
                            <MudText Typo="@Typo.h6">
                                Leave a rate about this recommendation
                            </MudText>
                            <MudRating />
                            <MudDivider Class="mt-2 mb-4" />
                        </MudElement>
                        <MudButton Link="@LinkToSelectedRecommendedUserProfile"
                                   Variant="@Variant.Outlined"
                                   Color="@Color.Info">
                            @SharedLocalizer["Profile"]
                        </MudButton>
                        <MudButton Variant="@Variant.Outlined"
                                   Color="@Color.Error"
                                   OnClick="() => _user = null"
                                   Target="_blank">
                            @SharedLocalizer["Close"]
                        </MudButton>
                    </MudElement>
                </MudElement>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {

    private const int Elevation = 4;

    [Parameter] public Guid TeamId { get; set; }
    [CascadingParameter] private Task<AuthenticationState> State { get; set; }

    private MudTable<UserViewModel> _table;
    private Guid _authenticatedUserId;
    private UserViewModel _user;

    private string LinkToSelectedRecommendedUserProfile => $"/users/{_user.Id}/profile";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _authenticatedUserId = await ApiAuthenticationStateProvider.GetUserIdFromStateAsync(State);
    }

    private void SelectRecommendedUser(TableRowClickEventArgs<UserViewModel> args)
    {
        _user = args.Item;
    }

    private async Task<TableData<UserViewModel>> InitializeRecommendedTeammatesAsync(TableState state)
    {
        _authenticatedUserId = await ApiAuthenticationStateProvider.GetUserIdFromStateAsync(State);
        var (users, pagination) = await UsersService.GetWithPaginationHeaderAsync(new UsersParameters
        {
            PageNumber = state.Page + 1,
            PageSize = state.PageSize + 1,
        });

        users = users.Where(u => u.Profession == "Software Engineer" || u.Profession == "Developer").ToList();
        pagination.TotalEntitiesCount = users.Count();

        return new() { Items = users, TotalItems = pagination.TotalEntitiesCount };
    }

}
